  "integration_fields": {
    "_note": "장비 1대당 입력 항목 — 이기종 통합 매핑표의 행 단위",
    "identity": [
      {
        "id": "device_id",
        "label_ko": "장비 ID",
        "type": "text",
        "required": true
      },
      {
        "id": "category",
        "label_ko": "분류",
        "type": "select",
        "ref": "categories",
        "required": true
      },
      {
        "id": "device_type",
        "label_ko": "장비 종류",
        "type": "select",
        "ref": "category.devices",
        "required": true
      },
      {
        "id": "location",
        "label_ko": "설치 위치",
        "type": "text",
        "placeholder": "예: 1동 2구역 / 3번 필지"
      },
      {
        "id": "install_date",
        "label_ko": "설치일",
        "type": "date"
      }
    ],
    "vendor": [
      {
        "id": "maker",
        "label_ko": "제조사",
        "type": "text",
        "required": true,
        "examples": [
          "프리바(Priva)",
          "호겐도른",
          "그린씨에스",
          "우성하이텍",
          "신한에이텍",
          "씨드로닉스",
          "기타"
        ]
      },
      {
        "id": "model",
        "label_ko": "모델명",
        "type": "text"
      },
      {
        "id": "firmware",
        "label_ko": "펌웨어 버전",
        "type": "text"
      }
    ],
    "comm": [
      {
        "id": "protocol",
        "label_ko": "통신 프로토콜",
        "type": "select",
        "required": true,
        "options": [
          "MQTT",
          "Modbus-RTU(RS485)",
          "Modbus-TCP",
          "BACnet",
          "OPC-UA",
          "LoRaWAN",
          "HTTP/REST",
          "RS232",
          "디지털접점(DI/DO)"
        ]
      },
      {
        "id": "host",
        "label_ko": "주소(IP/호스트)",
        "type": "text",
        "placeholder": "192.168.0.x 또는 토픽 prefix"
      },
      {
        "id": "port",
        "label_ko": "포트",
        "type": "number",
        "placeholder": "502 / 1883 등"
      },
      {
        "id": "unit_id",
        "label_ko": "슬레이브/유닛 ID",
        "type": "number",
        "hint": "Modbus slave_id, LoRa devEUI 등"
      },
      {
        "id": "auth",
        "label_ko": "인증(계정/키)",
        "type": "text",
        "sensitive": true
      }
    ],
    "datapoints": {
      "_note": "장비별 데이터 포인트(태그) 리스트 — 각 포인트가 표준 변수로 매핑됨",
      "fields": [
        {
          "id": "tag",
          "label_ko": "포인트명/태그",
          "type": "text",
          "required": true,
          "placeholder": "예: AI001, holding_reg_40001, sensors/temp"
        },
        {
          "id": "address",
          "label_ko": "주소(레지스터/토픽)",
          "type": "text"
        },
        {
          "id": "data_type",
          "label_ko": "데이터형",
          "type": "select",
          "options": [
            "float",
            "int16",
            "uint16",
            "int32",
            "bool",
            "string"
          ]
        },
        {
          "id": "unit",
          "label_ko": "단위",
          "type": "text",
          "placeholder": "°C, %, ppm, dS/m, ml, W"
        },
        {
          "id": "scale",
          "label_ko": "배율(scale)",
          "type": "number",
          "default": 1
        },
        {
          "id": "offset",
          "label_ko": "오프셋(offset)",
          "type": "number",
          "default": 0
        },
        {
          "id": "rw",
          "label_ko": "읽기/쓰기",
          "type": "select",
          "options": [
            "read",
            "write",
            "read/write"
          ]
        },
        {
          "id": "poll_interval",
          "label_ko": "수집 주기(초)",
          "type": "number",
          "default": 60
        },
        {
          "id": "canonical_name",
          "label_ko": "표준 변수 매핑",
          "type": "select",
          "ref": "canonical_names",
          "hint": "variable_registry 표준명으로 매핑 → 화면·모델이 제조사 무관하게 사용"
        }
      ]
    }
  },
