# Smart Farm AI Platform — environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# 자동 생성 값 (최초 설정 시 아래 명령으로 발급):
#   JWT_SECRET_KEY   : openssl rand -hex 32
#   AIRFLOW_FERNET_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   POSTGRES_PASSWORD: openssl rand -base64 16 | tr -dc 'A-Za-z0-9@#' | head -c 20

# ── Database (TimescaleDB / PostgreSQL) ───────────────────────────────────────

# PostgreSQL superuser password for 'smartfarm' user
POSTGRES_PASSWORD=change_me_strong_db_password

# Full SQLAlchemy connection URL (constructed from POSTGRES_PASSWORD)
DATABASE_URL=postgresql://smartfarm:change_me_strong_db_password@db/smartfarm

# ── nginx ─────────────────────────────────────────────────────────────────────

# Port exposed externally (dashboard + API proxy)
NGINX_PORT=80

# ── API ───────────────────────────────────────────────────────────────────────

# API internal port (runs behind nginx)
API_PORT=8000

# JWT secret key — generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_me_use_openssl_rand_hex_32

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000

# API admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password

# ── Airflow ───────────────────────────────────────────────────────────────────

# Fernet key for Airflow — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change_me_generate_fernet_key

# Airflow web UI admin account
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow_admin_password

# ── Pipeline scheduler ────────────────────────────────────────────────────────

# Directory on HOST containing new sensor CSV files for incremental ETL
ETL_DATA_DIR=./etl_data

# Cron schedule for incremental ETL (default: 02:00 daily)
ETL_CRON_SCHEDULE=0 2 * * *

# Cron schedule for retrain trigger check (default: 03:00 daily)
RETRAIN_CRON_SCHEDULE=0 3 * * *

# New-row thresholds that trigger a retrain
RETRAIN_ENV_ROWS=500
RETRAIN_PROD_ROWS=200

# ── MQTT (IoT 센서) ──────────────────────────────────────────────────────────

# Mosquitto 브로커 (Docker 내부: mqtt, 외부: localhost)
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
MQTT_WS_PORT=9001
MQTT_CLIENT_ID=smartfarm-subscriber
MQTT_KEEPALIVE=60
# 운영 환경에서는 아래 인증 설정
MQTT_USERNAME=
MQTT_PASSWORD=

# ── 기상청 API (KMA ASOS) ─────────────────────────────────────────────────────

# https://www.data.go.kr → "기상청_지상(종관, ASOS) 일자료 조회서비스" 신청
# 미설정 시 data_collection_dag의 KMA 수집 태스크를 건너뜀
KMA_SERVICE_KEY=

# ASOS 지점 번호 (기본: 108=서울, 지점코드 목록: https://asos.kma.go.kr)
KMA_STN_IDS=108

# ── KAMIS 농산물 가격 API ─────────────────────────────────────────────────────

# https://www.kamis.or.kr → 오픈API 신청
# KAMIS_API_KEY  : 인증키(certkey_no)
# KAMIS_CERT_KEY : 인증키(p_cert_key)
# 미설정 시 Mock 데이터로 동작
KAMIS_API_KEY=
KAMIS_CERT_KEY=
KAMIS_API_ID=pad_smartfarm
KAMIS_MARKET=1101   # 1101=서울 가락시장, 2100=부산

# ── 농촌진흥청 API (RDA) ──────────────────────────────────────────────────────

# https://www.data.go.kr → "농촌진흥청 스마트팜 생육 데이터" 신청 (선택)
# 미설정 시 RDA 수집 태스크를 건너뜀
RDA_API_KEY=

# ── Notifications (Slack / Email) ─────────────────────────────────────────────

# Slack Incoming Webhook URL (leave empty to disable)
# Create at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Email recipients (comma-separated, leave empty to disable)
NOTIFY_EMAIL_TO=

# SMTP settings (required only if NOTIFY_EMAIL_TO is set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=smartfarm@yourdomain.com

# Environment label shown in notification messages
NOTIFY_ENV=production

# ── SMS / 카카오 알림톡 (CoolSMS) ─────────────────────────────────────────────
# CoolSMS 가입 후 API 키 발급: https://coolsms.co.kr
COOLSMS_API_KEY=
COOLSMS_API_SECRET=
NOTIFY_PHONE_FROM=                 # 발신 번호 (사전 등록 필요, 예: 01012345678)
NOTIFY_PHONE_TO=                   # 수신 번호 목록, 쉼표 구분 (예: 01011112222,01033334444)

# 카카오 알림톡 (선택 — 미설정 시 SMS로 자동 대체)
# 카카오 비즈니스 채널 등록 후 플러스친구 ID와 템플릿 코드를 입력하세요.
KAKAO_PFID=                        # 플러스친구 ID (예: @스마트팜)
KAKAO_TEMPLATE_ID=                 # 승인된 알림톡 템플릿 코드

# ── 재배 환경 권고 설정 ────────────────────────────────────────────────────────
ADVISOR_COOLDOWN_SEC=1800          # 동일 농장·항목 재발송 대기 시간 (초, 기본 30분)
ADVISOR_DRY_RUN=0                  # 1로 설정 시 알림 미발송, 로그만 출력

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── 노지 공공데이터 연동 (선택) ──────────────────────────────────────────
# 설정 시 F2 필지/F4 토양이 Mock → 실데이터로 자동 전환됩니다.
# 흙토람 토양검정 OpenAPI (soil.rda.go.kr/openapi 에서 키 발급)
NAAS_SOIL_API_URL=
# 팜맵 농경지전자지도 OpenAPI (data.go.kr 신청 + IP 등록)
FARMMAP_API_URL=
# 농가 필지 식별자 (PNU 지번코드 19자리 / 행정구역 코드)
DEFAULT_FIELD_PNU=
DEFAULT_ADM_CODE=
