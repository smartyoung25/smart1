# ============================================================
# KAASA SmartOS 환경설정 예시 (.env.example)
# 실제 .env 는 커밋 금지(.gitignore). 운영 시 아래를 채우세요.
# ============================================================

# ── 보안 (공개 배포 전 필수) ─────────────────────────────
JWT_SECRET_KEY=            # 필수! 강력한 랜덤값: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=            # 공개 배포 시 강력한 값으로 변경 (기본 1250 금지)
ALLOWED_ORIGINS=https://your.domain.com   # 배포 도메인만 허용
PUBLIC_DEMO=               # 1=공개 데모(읽기전용: 쓰기·관리자 차단). 운영은 공란.

# ── DB / 인프라 ──────────────────────────────────────────
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://smartfarm:<PW>@127.0.0.1:5432/smartfarm
API_PORT=8000
NGINX_PORT=80
NGINX_SSL_PORT=443

# ── 외부 API 키 (주입 시 Mock→실데이터 자동 전환) ────────
DATA_GO_KR_SERVICE_KEY=           # 흙토람/팜맵 등 공공데이터
KMA_SERVICE_KEY=                  # 기상청 ASOS
KAMIS_API_KEY=                    # 도매시세
KAMIS_CERT_KEY=
KAMIS_API_ID=
RDA_API_KEY=                      # 농진청
ANTHROPIC_API_KEY=                # AI 챗봇 LLM (없으면 규칙형 폴백)
NAAS_SOIL_API_URL=                # 노지 토양 실측
FARMMAP_API_URL=                  # 필지 GIS 실측
