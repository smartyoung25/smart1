# ──────────────────────────────────────────────────────────────────────────────
# Smart Farm AI Platform — 환경변수 템플릿
# 이 파일을 복사하여 .env 로 저장하고 실제 값을 채우세요.
# cp .env.example .env
# .env 는 .gitignore 에 포함되어 있으므로 커밋되지 않습니다.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=smartfarm
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=smartfarm

# ── KMA 공공데이터포털 서비스키 ──────────────────────────────────────────────
# https://www.data.go.kr 에서 발급
KMA_SERVICE_KEY=CHANGE_ME_KMA_SERVICE_KEY

# ── CORS 허용 Origin (쉼표로 구분) ──────────────────────────────────────────
# 로컬 개발: http://localhost:3000
# 운영: https://your-frontend-domain.com
ALLOWED_ORIGINS=http://localhost:3000

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_AIRFLOW_PASSWORD
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=CHANGE_ME_FERNET_KEY
